# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=

# Optional settings (these are the defaults)
REIMBURST_MODEL=claude-sonnet-5-5
REIMBURST_EFFORT=medium
# 1 = no API calls; only the bundled sample receipts work
REIMBURST_OFFLINE=0
# 1 = reuse Claude's answer when the same file is uploaded again (instant and free)
REIMBURST_CACHE=1
